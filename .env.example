APP_NAME="Steel Fused Solutions and SS Metal Foundry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8002
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ssmf_laravel
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

SESSION_TABLE=adaptador_sesiones

DB_CACHE_TABLE=adaptador_datos_cache

DB_CACHE_LOCK_TABLE=adaptador_bloqueos_cache

DB_QUEUE_TABLE=adaptador_trabajos_cola

AUTH_PASSWORD_RESET_TOKEN_TABLE=adaptador_tokens_recuperacion_contrasena
